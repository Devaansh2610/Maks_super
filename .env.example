# Copy this file to .env and fill in your own values.
# Nothing in here should require a paid plan.

# --- Groq (fast hosted inference -- every agent's chat model) ---
# Free API key: https://console.groq.com
GROQ_API_KEY=
# gpt-oss-20b is Groq's fastest model by output tokens/sec and has solid
# tool-calling -- it's the official replacement for the now-deprecated
# llama-3.1-8b-instant.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.3

# --- Ollama -- kept only for local embeddings (the fast-path router below),
# chat no longer runs through it. `ollama pull all-minilm` to fetch it. ---
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=all-minilm
# 0-1 cosine-similarity cutoff for the embedding router to route straight to
# a specialist with no LLM call; below this (or on an ambiguous/compound
# request) it falls back to the full supervisor.
ROUTER_SIMILARITY_THRESHOLD=0.72

# --- Wake word / voice ---
# Iron Man's JARVIS wake line -- fuzzy-matched, so it doesn't need to be exact.
WAKE_PHRASE=daddy's home
WAKE_MATCH_THRESHOLD=78
VOSK_MODEL_PATH=./models/vosk-model-small-en-us-0.15
WHISPER_MODEL_SIZE=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# How hard webrtcvad filters non-speech before it ever reaches the wake-word
# or command listener: 0 (least aggressive) - 3 (most aggressive). 3 cuts
# down background-noise false triggers at a small risk of clipping very
# quiet speech.
VAD_AGGRESSIVENESS=3
# How much trailing silence ends a recorded command. Lower = snappier
# cutoff, higher = more tolerant of natural pauses mid-sentence.
COMMAND_SILENCE_SECONDS=0.9
MIC_DEVICE=
SPEAKER_DEVICE=

# --- Greeting / weather (Open-Meteo, no API key needed) ---
WEATHER_CITY=Delhi
WEATHER_LAT=28.6514
WEATHER_LON=77.2315

# --- Dashboard ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8420

# --- Mac companion (runs on the Mac, same LAN) ---
MAC_COMPANION_URL=http://192.168.1.50:8765
MAC_COMPANION_TOKEN=change-me-to-a-long-random-string

# --- Google Workspace (Gmail + Calendar) ---
# Create an OAuth client (Desktop app) in Google Cloud Console, download the
# JSON, point this at it. First run will open a browser to authorize once;
# the resulting token is cached at GOOGLE_TOKEN_PATH.
GOOGLE_CREDENTIALS_PATH=./secrets/google_credentials.json
GOOGLE_TOKEN_PATH=./secrets/google_token.json

# --- Notion ---
# Create an internal integration at https://www.notion.so/my-integrations
NOTION_TOKEN=

# --- Coding handoff ---
# Directory Claude Code should default to when Maks hands it a coding task.
CLAUDE_DEFAULT_PROJECT_DIR=~/projects
CLAUDE_CLI_BIN=claude

# --- Fish Audio (cloud TTS) ---
# Get a key at https://fish.audio -- s2.1-pro-free is free under fair use.
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_VOICE_ID=612b878b113047d9a770c069c8b4fdfe

# --- LangSmith (optional, free tier available) ---
# Traces every supervisor/agent run so you can see routing decisions, tool
# calls, and latency per step at https://smith.langchain.com. Pre-wired and
# on by default -- get a free API key there and paste it over the
# placeholder below, nothing else to change (langchain-core reads these
# straight from the environment; maks/settings.py loads .env into it).
# Set LANGSMITH_TRACING=false to turn tracing back off.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=paste-your-langsmith-api-key-here
LANGSMITH_PROJECT=maks
# Only needed if your LangSmith org is outside the US:
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
